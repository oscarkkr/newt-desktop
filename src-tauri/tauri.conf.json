{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "新T树洞",
  "version": "0.6.3",
  "identifier": "app.newt.desktop",
  "build": { "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "title": "新T树洞",
      "width": 1280,
      "height": 820,
      "minWidth": 900,
      "minHeight": 620,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false }
}
